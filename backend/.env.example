PORT=5000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/<database>?retryWrites=true&w=majority
UPLOAD_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Configure this preset as signed, with JPG/PNG/WEBP and a 10 MB max file size.
CLOUDINARY_UPLOAD_PRESET=pixora_signed

# Optional until you enable real background removal.
REMOVE_BG_API_KEY=